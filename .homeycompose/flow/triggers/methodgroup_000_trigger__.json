{
    "id": "methodgroup_trigger__",
    
    "title": {
      "en": "Method without Arguments, conditions as [[conditioncardsmode]] and [[actioncardsmode]]"
    },
    "args": [
      {
          "type" : "device",
          "name" : "device",
          "filter": "driver_id=methodgroup"
      },
      {
          "type": "dropdown",
          "name": "conditioncardsmode",
          "placeholder": {
              "en": "Conditioncard mode"
          },
          "values": [
              {
                  "id": "if-or-or",
                  "name": "if-or-or",
                  "label": {
                    "en": "If-Or-Or (Default)"
                  }
              },{
                  "id": "if-or-finally",
                  "name": "if-or-finally",
                  "label": {
                    "en": "If-Or-Finally"
                  }
              },{
                "id": "try-catch-finally",
                "name": "try-catch-finally",
                "label": {
                  "en": "Try-Catch-Finally"
                }
              }
          ]
      },
      {
          "type": "dropdown",
          "name": "actioncardsmode",
          "placeholder": {
              "en": "Actioncard mode"
          },
          "values": [
              {
                  "id": "async",
                  "name": "async",
                  "label": {
                    "en": "Executing actioncards asynchroon (default)"
                  }
              },{
                  "id": "sync",
                  "name": "sync",
                  "label": {
                    "en": "Executing actioncards synchroon"
                  }
              }
          ]
      }
    ]    
  }